# Cloudflare Pages CDN cache rules.
# Format: pattern, then header lines indented with two spaces.
# Pages reads this at deploy time and applies the rules at the edge.

# JS / CSS are loaded by FIXED, non-content-hashed paths (js/app.js,
# js/confidence.js, css/style.css …). The previous `max-age=31536000,
# immutable` was a footgun: because the filenames never change, a returning
# visitor's browser kept running last year's code FOREVER — every deploy was
# silently invisible to anyone who'd visited before (verified 2026-06-07: a
# freshly-deployed module did not execute in a browser that had cached the
# prior build). "immutable" is only safe with content-hashed filenames, which
# this no-build-step app doesn't have.
#
# Fix: `no-cache` = the browser MAY store the file but MUST revalidate with the
# origin (via ETag) before using it. Cloudflare returns a cheap 304 when the
# file is unchanged (no body re-download), so repeat loads stay fast, but the
# instant a deploy changes a file the user gets it on their next load. This is
# the correct policy for an unversioned, frequently-deployed SPA.
/css/*
  Cache-Control: public, no-cache

/js/*
  Cache-Control: public, no-cache

# HTML and the manifest must NOT be cached aggressively — every push
# we want users to see the new index.html / new manifest immediately.
# 5-minute browser cache + revalidate-on-stale gives a good balance:
# the worker push lands, the edge picks it up in under 60s, and the
# user's next page load (within the next 5 min) gets the fresh HTML
# even if their browser had a slightly older copy cached.
/
  Cache-Control: public, max-age=300, must-revalidate

/index.html
  Cache-Control: public, max-age=300, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=300, must-revalidate

# Model artifacts: ONE rule, because Cloudflare Pages applies EVERY matching pattern and
# concatenates the results.
#
# This used to carry a specific `/model/ledger/recent.json -> no-cache` rule AND a general
# `/model/* -> max-age=3600` rule. Both matched the slice, so the edge actually served:
#
#     Cache-Control: public, no-cache, public, max-age=3600, must-revalidate
#
# which is self-contradictory. HTTP says no-cache wins, so the behaviour happened to be right, but
# it was right by accident -- any client that honoured the max-age instead would serve an hour-old
# slice, which is precisely the failure the no-cache rule was added to prevent (a stale slice put
# readTodayLock back on the visit-time fallback for up to an hour). A header that depends on
# precedence resolution to mean the correct thing is a latent bug, not a working config.
#
# So: no-cache for everything under /model/. These files are rewritten by the cron up to 8x a day
# and none of them are content-hashed, so revalidation is the only correct policy. It is cheap --
# brotli takes the 6.6 MB recent.json to 912 KB, and an unchanged file answers 304 with no body.
/model/*
  Cache-Control: public, no-cache
