# Generated training and backtest artifacts.
# Re-runnable, large, and machine-specific — don't commit.
model/lstm_weights.json
model/metrics.json
model/xgb_model.json
model/xgb_metrics.json
model/backtest_results.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# OS
Thumbs.db

# Local-only
.test-screenshots/
workers/yahoo-proxy/.wrangler/
workers/push-alerts/.wrangler/

# Capacitor / Node — see BUILD_ANDROID_APK.md for setup. The android/
# folder ITSELF should be committed (after `npx cap add android` runs
# once on a Mac), but build outputs inside it are huge and rebuildable.
node_modules/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/release/

# Build artifacts that embed the absolute source path. On this machine the
# Windows username is also the owner's employer alias, so any file recording
# a Windows user path leaks identity into a PUBLIC repo. Verified: a .pyc in
# this repo contained the full path to penny_universe.py.
# Enforced by .githooks/pre-commit and tools/check_no_corp_identity.py.
*.pyd
*.egg-info/
.mypy_cache/
.coverage
htmlcov/
*.log
*.map
.wrangler/
*.tsbuildinfo

# Scratch output from tools/ runs: report dumps, CSV exports, ledger snapshots
# taken before a destructive re-resolution. Local diagnostics, never artifacts.
# An 89 MB ledger snapshot committed by accident is very hard to remove later.
tools/_*

# Historical replay artifacts. Derived data, regenerable from tools/replay_history.py
# in minutes, and far too large to track: the 500-symbol 12-year panel is ~150 MB,
# well past GitHub's 100 MiB per-file limit, and the bars cache is hundreds of files.
# The repo already carries a ~97 MB ledger; adding these would make it unusable.
model/replay_panel.jsonl
model/replay_panel*.jsonl
model/_bars_cache/
model/_replay*.log
model/_replay*.jsonl

# Mia 2.0 scratch: the request/advice handoff between bot/run.py and bot/advise.mjs.
# Regenerated on every run and can contain a large per-symbol analysis dump. The
# AUTHORITATIVE files (state.json, config.json, trades.jsonl, runs.jsonl) are tracked.
model/bot/_*
