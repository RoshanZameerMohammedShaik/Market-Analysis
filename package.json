{
    "name": "market-analyzer",
    "version": "1.0.0",
    "description": "Real-time stock + crypto prediction engine with browser-only ML inference and Mia chatbot. Native shell wraps the live app at https://market-ai.pages.dev.",
    "private": true,
    "scripts": {
        "cap:add:android": "npx cap add android",
        "cap:sync": "npx cap sync",
        "cap:open:android": "npx cap open android",
        "android:build:debug": "cd android && ./gradlew assembleDebug",
        "android:build:release": "cd android && ./gradlew assembleRelease"
    },
    "devDependencies": {
        "@capacitor/cli": "^6.1.2"
    },
    "dependencies": {
        "@capacitor/android": "^6.1.2",
        "@capacitor/core": "^6.1.2"
    }
}
